# =============================================================================
# BodyVision – variables d'environnement (modèle). Copier en `.env` puis remplir :
#     cp .env.example .env
# `.env` contient des secrets : il est ignoré par Git. Ne commitez QUE ce fichier-ci.
# Générer un secret :   python3 -c "import secrets; print(secrets.token_hex(24))"
# (hexadécimal : évite les caractères que Docker Compose interprète, comme $)
# =============================================================================

# ---- PostgreSQL : instance partagée par tous les services -------------------
POSTGRES_DB=bodyvision
POSTGRES_USER=postgres
# Super-utilisateur : sert uniquement à l'initialisation et à l'administration. Aucun service ne l'utilise.
POSTGRES_PASSWORD=
# Port publié sur 127.0.0.1 de votre machine (DBeaver, psql...). Pas exposé hors de la machine.
POSTGRES_HOST_PORT=5432

# ---- Rôles SQL par service (un rôle = un schéma, aucun accès aux autres schémas)
AUTH_DB_USER=bv_utilisateurs
AUTH_DB_PASSWORD=
ANALYTIQUE_DB_USER=bv_analytique
ANALYTIQUE_DB_PASSWORD=

# ---- Secret partagé pour les appels service-à-service (minimum 16 caractères)
# Même valeur pour tous les services qui s'appellent entre eux (Analytique -> Auth).
INTERNAL_SERVICE_TOKEN=

# ---- Service Auth ------------------------------------------------------------
# Convention de ports publiés sur la machine : auth 8001, ingestion 8002, analytique 8003...
AUTH_HOST_PORT=8001
# Adresse d'écoute du port publié. Défaut 127.0.0.1 (votre machine seulement). Mettre 0.0.0.0 pour qu'un
# téléphone sur le même Wi-Fi puisse joindre l'API (DÉVELOPPEMENT UNIQUEMENT). Optionnel : décommenter pour changer.
# AUTH_BIND_ADDRESS=127.0.0.1
JWT_ISSUER=bodyvision-auth
JWT_AUDIENCE=bodyvision
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true = crée la paire de clés RSA au 1er démarrage (volume Docker `auth_keys`). DÉVELOPPEMENT UNIQUEMENT.
# En production : false, et fournir la clé via un secret (JWT_PRIVATE_KEY_FILE).
JWT_AUTOGENERATE_KEYS=true
# Joue `alembic upgrade head` au démarrage. En Kubernetes avec plusieurs réplicas : false + un Job de migration.
RUN_MIGRATIONS=true
LOG_LEVEL=INFO
# Swagger UI (/docs), ReDoc (/redoc), /openapi.json
ENABLE_DOCS=true
